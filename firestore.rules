rules_version = '2';

// Foodidu website (static/js/site.js). Browsers may only add the three kinds of records below, in the exact
// shape the site sends, and can never read anything back: open them in Firebase console > Firestore.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function str(v, max) { return v is string && v.size() <= max; }
    // Who may read partner applications on foodidu.com/dashboard/ (Google sign-in). Add more emails to the list.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['abdelrhmannkhaledd1@gmail.com'];
    }
    function smallMap(v) { return v is map && v.size() <= 20; }

    // Cookie consent, one document per visitor, written with set(..., {merge: true}).
    function consentFields() {
      return ['visitorId', 'userId', 'essential', 'analytics', 'marketing', 'timestamp', 'deviceInfo', 'location', 'sessionInfo'];
    }
    function consentOk(d) {
      return str(d.userId, 100) && d.essential is bool && d.analytics is bool && d.marketing is bool
        && d.timestamp == request.time && smallMap(d.deviceInfo) && smallMap(d.location) && smallMap(d.sessionInfo);
    }
    match /cookieConsent/{visitorId} {
      allow create: if request.resource.data.keys().hasOnly(consentFields())
        && request.resource.data.visitorId == visitorId && str(visitorId, 100) && consentOk(request.resource.data);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(consentFields())
        && request.resource.data.visitorId == visitorId && consentOk(request.resource.data);
      allow read, delete: if false;
    }

    // One record per consent given (same fields + session id and event type).
    match /userSessions/{id} {
      allow create: if request.resource.data.keys().hasOnly(consentFields().concat(['sessionId', 'eventType']))
        && str(request.resource.data.visitorId, 100) && consentOk(request.resource.data)
        && str(request.resource.data.sessionId, 60) && str(request.resource.data.eventType, 40);
      allow read, update, delete: if false;
    }

    // Requests from Foodidu Business (/business/: the full form, or the quick form in the hero with only name, person and
    // phone); a second copy next to the Google Sheet.
    match /vendorApplications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['businessName', 'contactPerson', 'phone', 'email', 'location',
            'businessType', 'description', 'website', 'language', 'page', 'createdAt'])
        && request.resource.data.keys().hasAll(['businessName', 'contactPerson', 'phone', 'language', 'createdAt'])
        && str(request.resource.data.businessName, 200) && request.resource.data.businessName.size() > 0
        && str(request.resource.data.contactPerson, 200) && request.resource.data.contactPerson.size() > 0
        && str(request.resource.data.phone, 40) && request.resource.data.phone.size() > 0
        && (!('email' in request.resource.data) || (str(request.resource.data.email, 200) && request.resource.data.email.matches('.+@.+')))
        && (!('location' in request.resource.data) || str(request.resource.data.location, 300))
        && (!('businessType' in request.resource.data) || str(request.resource.data.businessType, 60))
        && (!('description' in request.resource.data) || str(request.resource.data.description, 3000))
        && (!('website' in request.resource.data) || str(request.resource.data.website, 500))
        && request.resource.data.language in ['en', 'ar']
        && (!('page' in request.resource.data) || str(request.resource.data.page, 200))
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();   // the dashboard's "Partner applications" section
      allow update, delete: if false;
    }

    // The demo QR menu's group orders (static/js/menu-demo.js): read by their random id only (never listed), editable for
    // one day, small. Turn on a TTL policy on expireAt in the console to delete old ones automatically.
    match /demoGroups/{gid} {
      function groupShape(d) {
        return d.keys().hasOnly(['createdAt', 'expireAt', 'lang', 'table', 'people', 'items'])
          && d.people is list && d.people.size() <= 12 && d.items is list && d.items.size() <= 120
          && d.lang in ['en', 'ar'] && d.table is string && d.table.size() <= 4;
      }
      allow get: if true;
      allow create: if gid.matches('^[A-Za-z0-9]{16}$') && groupShape(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time && request.resource.data.expireAt < request.time + duration.value(2, 'd');
      allow update: if groupShape(request.resource.data) && resource.data.expireAt > request.time
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.expireAt == resource.data.expireAt
        && request.resource.data.lang == resource.data.lang && request.resource.data.table == resource.data.table;
      allow list, delete: if false;
    }

    // Everything else: no access from browsers (the console and admin tools are not affected).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
